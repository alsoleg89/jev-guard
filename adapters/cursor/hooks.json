{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "python3 /ABSOLUTE/PATH/TO/jev-bouncer/bouncer.py cursor beforeShellExecution",
        "timeout": 30
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "python3 /ABSOLUTE/PATH/TO/jev-bouncer/bouncer.py cursor beforeMCPExecution",
        "timeout": 30
      }
    ],
    "preToolUse": [
      {
        "command": "python3 /ABSOLUTE/PATH/TO/jev-bouncer/bouncer.py cursor preToolUse",
        "timeout": 30
      }
    ],
    "postToolUse": [
      {
        "command": "python3 /ABSOLUTE/PATH/TO/jev-bouncer/bouncer.py cursor postToolUse",
        "timeout": 30
      }
    ]
  }
}
